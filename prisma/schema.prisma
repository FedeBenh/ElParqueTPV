// Esquema Prisma para tienda de alimentación
// PostgreSQL compatible con Vercel (Neon/Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Articulo {
  id               Int       @id @default(autoincrement())
  codigo           String    @unique
  nombre           String
  descripcion      String?
  categoria        String?
  categoriaId      Int?
  categoriaRel     Categoria? @relation(fields: [categoriaId], references: [id])
  imagenUrl        String?
  precioCompra     Decimal   @db.Decimal(10,2)
  precioVenta      Decimal   @db.Decimal(10,2)
  stockActual      Int
  stockMinimo      Int
  activo           Boolean   @default(true)
  fechaAlta        DateTime  @default(now())
  fechaModificacion DateTime @updatedAt
  comprasLineas    CompraLinea[]
  ventasLineas     VentaLinea[]
  movimientos      MovimientoStock[]
}

model Compra {
  id            Int           @id @default(autoincrement())
  fecha         DateTime      @default(now())
  proveedor     String?
  totalCompra   Decimal       @db.Decimal(10,2)
  observaciones String?
  lineas        CompraLinea[]
}

model CompraLinea {
  id         Int      @id @default(autoincrement())
  compra     Compra   @relation(fields: [compraId], references: [id])
  compraId   Int
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  articuloId Int
  cantidad   Int
  precioCompra Decimal @db.Decimal(10,2)
  subtotal   Decimal   @db.Decimal(10,2)
}

model Venta {
  id            Int           @id @default(autoincrement())
  fecha         DateTime      @default(now())
  totalVenta    Decimal       @db.Decimal(10,2)
  metodoPago    MetodoPago?
  observaciones String?
  lineas        VentaLinea[]
  cajaSesion    CajaSesion?   @relation(fields: [cajaSesionId], references: [id])
  cajaSesionId  Int?
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  BIZUM
  OTRO
}

model VentaLinea {
  id         Int      @id @default(autoincrement())
  venta      Venta    @relation(fields: [ventaId], references: [id])
  ventaId    Int
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  articuloId Int
  cantidad   Int
  precioVenta Decimal @db.Decimal(10,2)
  subtotal   Decimal  @db.Decimal(10,2)
}

model MovimientoStock {
  id         Int      @id @default(autoincrement())
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  articuloId Int
  tipo       TipoMovimiento
  cantidad   Int
  fecha      DateTime @default(now())
  referencia String?
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  descripcion String?
  color     String?
  imagenUrl String?
  activa    Boolean   @default(true)
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articulos Articulo[]
}

model CajaSesion {
  id                    Int                  @id @default(autoincrement())
  fechaApertura         DateTime             @default(now())
  fechaCierre           DateTime?
  efectivoInicial       Decimal              @db.Decimal(10,2) @default("0.00")
  efectivoEsperado      Decimal              @db.Decimal(10,2) @default("0.00")
  efectivoContado       Decimal              @db.Decimal(10,2) @default("0.00")
  diferencia            Decimal              @db.Decimal(10,2) @default("0.00")
  estado                CajaEstado           @default(ABIERTA)
  observacionesApertura String?
  observacionesCierre   String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  denominaciones        CajaDenominacion[]
  movimientos           CajaMovimiento[]
  ventas                Venta[]
}

enum CajaEstado {
  ABIERTA
  CERRADA
}

model CajaDenominacion {
  id           Int             @id @default(autoincrement())
  cajaSesion   CajaSesion      @relation(fields: [cajaSesionId], references: [id])
  cajaSesionId Int
  tipo         DenominacionTipo
  valor        Decimal         @db.Decimal(10,2)
  cantidad     Int
  total        Decimal         @db.Decimal(10,2)
}

enum DenominacionTipo {
  MONEDA
  BILLETE
}

model CajaMovimiento {
  id           Int           @id @default(autoincrement())
  cajaSesion   CajaSesion    @relation(fields: [cajaSesionId], references: [id])
  cajaSesionId Int
  tipo         MovimientoTipo
  concepto     String
  importe      Decimal       @db.Decimal(10,2)
  fecha        DateTime      @default(now())
  observaciones String?
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
}
